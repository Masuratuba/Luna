# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback supported:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only: required for owner-secret mode and privileged persistence
SUPABASE_SERVICE_ROLE_KEY=

# LUNA owner/admin (server-only; never expose to client/agents)
LUNA_OWNER_SECRET=
LUNA_OWNER_USER_ID=
LUNA_TRUSTED_AUTH_ISSUER=

# 32-byte base64 key used to encrypt OAuth tokens at rest
LUNA_TOKEN_ENCRYPTION_KEY=

# OpenAI (server-only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_SEARCH_MODEL=

# External analytics provider (server-only; configure when selected)
ANALYTICS_PROVIDER_URL=
ANALYTICS_PROVIDER_API_KEY=

# External commerce provider (server-only; configure when selected)
COMMERCE_PROVIDER_URL=
COMMERCE_PROVIDER_API_KEY=

# Microsoft Graph OAuth (server-only)
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
MICROSOFT_GRAPH_REDIRECT_URI=https://luna-tuba8.vercel.app/api/integrations/microsoft/callback

# Legacy fallback only; OAuth connection storage is preferred.
MICROSOFT_GRAPH_ACCESS_TOKEN=
